# Copy to .env and fill in. NEVER commit the real .env.
# Run `python scripts/probe_providers.py` after filling this in — it reports which
# keys and model ids actually work, without printing any key.

# ---- Active LLM provider ----
# One of: groq | google | openrouter | xai | openai
LLM_PROVIDER=groq
# Optional: force a specific model id (else the provider default from config.py is used).
# LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# Cross-provider fallback: if the active provider fails (rate limit, outage, bad model id),
# try these next, in order. Set to "" to disable and fail fast.
LLM_FALLBACK_PROVIDERS=google,openrouter

# ---- Provider keys (only the ones you have) ----
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# ---- Database: Supabase Postgres ----
# Use the SESSION POOLER string (IPv4-compatible). The direct db.<ref>.supabase.co host is
# IPv6-only and will NOT resolve on Streamlit Cloud.
# URL-encode special chars in the password (e.g. '@' -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---- Retrieval ----
# BM25 always works and needs no key. Vector search additionally needs an embedding provider.
EMBEDDING_PROVIDER=none          # none | google | openai
RETRIEVAL_MODE=bm25              # bm25 | vector | hybrid

# ---- Research source ----
# Local corpus is the default so evaluation is deterministic and reproducible.
ENABLE_LIVE_SEARCH=false
TAVILY_API_KEY=

# ---- Workflow limits (Week 4 §14, §18, §22 — runaway/cost control) ----
MAX_REVISION_CYCLES=2            # critic loop hard cap; workflow MUST terminate at this
MAX_RESEARCH_ROUNDS=2            # re-plan rounds when evidence is thin
MAX_AGENT_CALLS_PER_RUN=40       # global circuit breaker
MAX_PARALLEL_RESEARCHERS=4
AGENT_TIMEOUT_SECONDS=60
MAX_RUN_SECONDS=600
MAX_COST_USD_PER_RUN=0.50        # estimated; run aborts if exceeded
